# Copy this file to .env.local (local dev) or set these as environment
# variables in your host's dashboard (Vercel/Render). Never commit real values.

# --- MongoDB (Atlas connection string) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=torii_portfolio

# --- Team passwords (stored ONLY as base64-encoded bcrypt hashes) ---
# Generate a hash for a password, then base64-encode it. Example (Node):
#   node -e "const b=require('bcryptjs');console.log(Buffer.from(b.hashSync('YOUR_PASSWORD',12)).toString('base64'))"
# CREATE = the account-creation password users type to make a profile.
CREATE_PASSWORD_HASH_B64=
# ADMIN = the password to register new employee codes in the allowlist.
ADMIN_PASSWORD_HASH_B64=

# --- Optional: raises GitHub API rate limits when fetching coding profiles ---
# GITHUB_TOKEN=
